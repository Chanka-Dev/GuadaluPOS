# ==========================================
# GuadaluPOS - Git Ignore Config
# ==========================================

# Secrets & Environment
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
*.key
auth.json

# Dependencies
vendor/
backend/vendor/
node_modules/
frontend/node_modules/
backend/node_modules/

# Compiled & Build outputs
frontend/dist/
frontend/dist/*
backend/public/build/
backend/public/hot/
backend/public/storage
dist/
out-tsc/
bazel-out/

# Caches & Storage
.angular/
frontend/.angular/
backend/storage/*.key
backend/storage/pail/
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/.phpunit.cache/
backend/.phpunit.result.cache

# Backups & Logs
*.log
*.backup
*.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs & System
.idea/
.vscode/
*.sublime-workspace
.DS_Store
Thumbs.db
